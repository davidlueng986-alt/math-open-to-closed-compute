// Fast F_32003 diagnostic for DEGREE-135-IV-GCD-FOUR (L-alone system)
// Normalization (WLOG): C0 = 1, r monic deg 4 with r3 = 0, N monic deg 5, M = r^2 + N.
// Eliminates all 10 constant-pivot linear variables:
//   n0 (-54 from R3), a3 (-81/16 from sq34), a2 (-81/7 from sq33),
//   a1 (-81/4 from sq32), a0 (-162/5 from sq31),
//   t3 (-2 from ode10), t2 (-4 from ode9), t1 (-6 from ode8), t0 (-8 from ode7),
//   p0 (-9 from sq26).
// Remaining: 10 parameters (t4, a4, n1, n2, n3, n4, r0, r1, r2, v6) + w (w*b2 - 1 = 0).

system("--ticks-per-sec", 1000);
int t0_clk = timer;

ring Rp = 32003, (t4, a4, w, n1, n2, n3, n4, r0, r1, r2, v6), dp;

proc polyDivByR(list Pin, list rpoly) {
  int da = size(Pin) - 1;
  list cur = Pin;
  list Qout;
  int i, j;
  for (i = 1; i <= da - 3; i++) { Qout[i] = poly(0); }
  for (i = da; i >= 4; i--) {
    poly cc = cur[i + 1];
    Qout[i - 3] = cc;
    if (cc != 0) {
      for (j = 0; j <= 4; j++) {
        cur[i - 4 + j + 1] = cur[i - 4 + j + 1] - cc * rpoly[j + 1];
      }
    }
  }
  list RemOut;
  for (i = 1; i <= 4; i++) { RemOut[i] = cur[i]; }
  return(list(Qout, RemOut));
}

proc serMul(list Ain, list Bin, int nord) {
  list Cout;
  int i, j;
  for (i = 1; i <= nord; i++) { Cout[i] = poly(0); }
  int na = size(Ain);
  int nb = size(Bin);
  for (i = 1; i <= na; i++) {
    if (i > nord) { break; }
    if (Ain[i] == 0) { continue; }
    for (j = 1; j <= nb; j++) {
      if (i + j - 1 > nord) { break; }
      if (Bin[j] == 0) { continue; }
      Cout[i + j - 1] = Cout[i + j - 1] + Ain[i] * Bin[j];
    }
  }
  return(Cout);
}

proc serInv(list Fin, int nord) {
  list sinv;
  sinv[1] = poly(1);
  int i, j;
  for (i = 2; i <= nord; i++) {
    poly acc = 0;
    for (j = 2; j <= i; j++) {
      if (j <= size(Fin) && Fin[j] != 0) {
        acc = acc + Fin[j] * sinv[i - j + 1];
      }
    }
    sinv[i] = -acc;
  }
  return(sinv);
}

proc serPowThird(list Qin, int nord) {
  list gser;
  gser[1] = poly(0);
  int i;
  for (i = 2; i <= nord; i++) { gser[i] = Qin[i]; }
  list pout;
  pout[1] = poly(1);
  for (i = 2; i <= nord; i++) { pout[i] = poly(0); }
  list sterm;
  sterm[1] = poly(1);
  number expo = number(1) / number(3);
  number binom = 1;
  int kk;
  for (kk = 1; kk < nord; kk++) {
    sterm = serMul(sterm, gser, nord);
    binom = binom * (expo - number(kk - 1)) / number(kk);
    for (i = 1; i <= nord; i++) {
      if (sterm[i] != 0) { pout[i] = pout[i] + binom * sterm[i]; }
    }
  }
  return(pout);
}

proc buildBhiRem(list rpoly, list Npoly) {
  list r_s = list(rpoly[5], rpoly[4], rpoly[3], rpoly[2], rpoly[1]);
  list N_s = list(Npoly[6], Npoly[5], Npoly[4], Npoly[3], Npoly[2], Npoly[1]);
  list N_inv = serInv(N_s, 10);
  list r_s2 = serMul(r_s, r_s, 10);
  list Qs = serMul(r_s2, N_inv, 10);
  list Qs2 = serMul(Qs, Qs, 10);
  list Qs3 = serMul(Qs2, Qs, 10);

  number b9 = number(9) / number(2);
  poly b6 = (number(9) / number(8)) * (4 * v6 - 13);
  poly b3 = (number(27) / number(500)) * (377 - 125 * v6);

  list B_hi;
  int mm;
  for (mm = 0; mm <= 9; mm++) { B_hi[mm + 1] = poly(0); }
  for (mm = 1; mm <= 9; mm++) {
    poly cc = b9 * Qs3[9 - mm + 1];
    if (mm <= 6) { cc = cc + b6 * Qs2[6 - mm + 1]; }
    if (mm <= 3) { cc = cc + b3 * Qs[3 - mm + 1]; }
    B_hi[mm + 1] = cc;
  }
  list dB_hi;
  for (mm = 0; mm <= 8; mm++) { dB_hi[mm + 1] = number(mm + 1) * B_hi[mm + 2]; }
  list qr = polyDivByR(dB_hi, rpoly);
  return(list(qr[1], qr[2], Qs, Qs2, Qs3, r_s));
}

proc computeHi(list Ain, list rpoly, list Mpoly, list gpoly) {
  list dA;
  int kk, jj, ii, dd;
  for (kk = 0; kk <= 12; kk++) { dA[kk + 1] = number(kk + 1) * Ain[kk + 2]; }
  list dr;
  for (kk = 0; kk <= 3; kk++) { dr[kk + 1] = number(kk + 1) * rpoly[kk + 2]; }
  list dAr = serMul(dA, rpoly, 17);
  list Adr = serMul(Ain, dr, 17);
  list Wp;
  for (kk = 1; kk <= 17; kk++) { Wp[kk] = dAr[kk] - Adr[kk]; }
  list RHS = serMul(Ain, Wp, 30);
  for (kk = 1; kk <= 30; kk++) { RHS[kk] = 18 * RHS[kk]; }

  list Tp;
  for (kk = 1; kk <= 23; kk++) { Tp[kk] = poly(0); }
  for (kk = 22; kk >= 5; kk--) {
    dd = kk + 7;
    poly lhs_rest = 0;
    for (jj = 0; jj <= 7; jj++) {
      ii = dd + 1 - jj;
      if (ii >= 5 && ii <= 22) {
        lhs_rest = lhs_rest + Tp[ii + 1] * number(2 * ii - jj) * Mpoly[jj + 1];
      }
    }
    Tp[kk + 1] = (RHS[dd + 1] - lhs_rest) / number(2 * kk - 8);
  }
  list gA = serMul(gpoly, Ain, 18);
  list pLp;
  pLp[1] = poly(0);
  for (kk = 0; kk <= 17; kk++) { pLp[kk + 2] = gA[kk + 1] / number(kk + 1); }

  list T2 = serMul(Tp, Tp, 45);
  list A2 = serMul(Ain, Ain, 27);
  list pA2 = serMul(pLp, A2, 45);
  list sqout;
  for (kk = 1; kk <= 45; kk++) { sqout[kk] = T2[kk] - 9 * pA2[kk]; }
  return(list(Tp, pLp, RHS, sqout));
}

// 1. Solve n0 from R3 = 0 (constant pivot -54)
list rpoly = list(r0, r1, r2, poly(0), poly(1));
list N_zero = list(poly(0), n1, n2, n3, n4, poly(1));
list N_one  = list(poly(1), n1, n2, n3, n4, poly(1));
list bres0 = buildBhiRem(rpoly, N_zero);
list bres1 = buildBhiRem(rpoly, N_one);
list rem0 = bres0[2];
list rem1 = bres1[2];
poly piv_n0 = rem1[4] - rem0[4];
if (piv_n0 != -54) { printf("ERROR: piv_n0 = %s", piv_n0); quit; }
poly n0_sol = rem0[4] / number(54);
printf("[%s ms] Solved n0 (terms=%s)", timer - t0_clk, size(n0_sol));

list Npoly = list(n0_sol, n1, n2, n3, n4, poly(1));
list bres = buildBhiRem(rpoly, Npoly);
list gpoly = bres[1];
list remB = bres[2];
list Qs = bres[3];
list Qs2 = bres[4];
list Qs3 = bres[5];
list r_s = bres[6];

if (remB[4] != 0) { printf("ERROR: R3 nonzero!"); quit; }
poly R2 = remB[3];
poly b2 = -remB[2] / number(2);
poly b1 = (number(2) / number(3)) * n4 * b2 - remB[1];
poly v2 = (number(2) / number(9)) * b2;
poly v1 = (number(2) / number(9)) * b1;
poly v3 = (number(3) / number(500)) * (500 * v6 - 1001);
printf("[%s ms] R2 terms=%s, b2 terms=%s, b1 terms=%s", timer - t0_clk, size(R2), size(b2), size(b1));

// 2. Build A_hi (u^13..u^5)
list Z1 = serPowThird(Qs, 10);
list Z2 = serMul(Z1, Z1, 10);
list rQ3 = serMul(r_s, Qs3, 10);
list rQ2 = serMul(r_s, Qs2, 10);
list rQ1 = serMul(r_s, Qs, 10);
list rZ2 = serMul(r_s, Z2, 10);
list rZ1 = serMul(r_s, Z1, 10);

list A_hi;
int mm;
for (mm = 0; mm <= 13; mm++) { A_hi[mm + 1] = poly(0); }
for (mm = 5; mm <= 13; mm++) {
  poly cc = rQ3[13 - mm + 1];
  if (mm <= 10) { cc = cc + v6 * rQ2[10 - mm + 1]; }
  if (mm <= 7)  { cc = cc + v3 * rQ1[7 - mm + 1]; }
  if (mm <= 6)  { cc = cc + v2 * rZ2[6 - mm + 1]; }
  if (mm <= 5)  { cc = cc + v1 * rZ1[5 - mm + 1]; }
  A_hi[mm + 1] = cc;
}

// 3. M = r^2 + N (deg 8)
list r2_poly = serMul(rpoly, rpoly, 9);
list Mpoly;
for (mm = 0; mm <= 8; mm++) {
  poly cc = r2_poly[mm + 1];
  if (mm <= 5) { cc = cc + Npoly[mm + 1]; }
  Mpoly[mm + 1] = cc;
}

// 4. Sequentially eliminate a3, a2, a1, a0
list Apoly = A_hi;
Apoly[5] = a4;

list ctmp;
list sq;

ctmp = computeHi(Apoly, rpoly, Mpoly, gpoly);
sq = ctmp[4];
Apoly[4] = sq[35] * (number(16) / number(81));
ctmp = computeHi(Apoly, rpoly, Mpoly, gpoly);
sq = ctmp[4];
if (sq[35] != 0) { printf("ERROR: eq34 failed!"); quit; }

Apoly[3] = sq[34] * (number(7) / number(81));
ctmp = computeHi(Apoly, rpoly, Mpoly, gpoly);
sq = ctmp[4];
if (sq[34] != 0) { printf("ERROR: eq33 failed!"); quit; }

Apoly[2] = sq[33] * (number(4) / number(81));
ctmp = computeHi(Apoly, rpoly, Mpoly, gpoly);
sq = ctmp[4];
if (sq[33] != 0) { printf("ERROR: eq32 failed!"); quit; }

Apoly[1] = sq[32] * (number(5) / number(162));
ctmp = computeHi(Apoly, rpoly, Mpoly, gpoly);
sq = ctmp[4];
if (sq[32] != 0) { printf("ERROR: eq31 failed!"); quit; }

printf("[%s ms] Eliminated a3..a0 (terms: %s, %s, %s, %s)",
       timer - t0_clk, size(Apoly[4]), size(Apoly[3]), size(Apoly[2]), size(Apoly[1]));

list Tpoly = ctmp[1];
list pLpoly = ctmp[2];
list RHS = ctmp[3];

// 5. Solve t3..t0 from ode10..ode7
Tpoly[5] = t4;
int kk, jj, ii, dd;
for (kk = 3; kk >= 0; kk--) {
  dd = kk + 7;
  poly lhs_rest = 0;
  for (jj = 0; jj <= 8; jj++) {
    ii = dd + 1 - jj;
    if (ii > kk && ii <= 22) {
      lhs_rest = lhs_rest + Tpoly[ii + 1] * number(2 * ii - jj) * Mpoly[jj + 1];
    }
  }
  Tpoly[kk + 1] = (RHS[dd + 1] - lhs_rest) / number(2 * kk - 8);
}

list dT, dM;
for (kk = 0; kk <= 21; kk++) { dT[kk + 1] = number(kk + 1) * Tpoly[kk + 2]; }
for (kk = 0; kk <= 7; kk++)  { dM[kk + 1] = number(kk + 1) * Mpoly[kk + 2]; }
list MTp = serMul(Mpoly, dT, 30);
list dMT = serMul(dM, Tpoly, 30);
list ode;
for (kk = 1; kk <= 30; kk++) { ode[kk] = 2 * MTp[kk] - dMT[kk] - RHS[kk]; }
printf("[%s ms] Built ODE (ode11=%s, ode6=%s, ode0=%s terms)",
       timer - t0_clk, size(ode[12]), size(ode[7]), size(ode[1]));

// 6. Solve p0 from eq26 (pivot -9)
list T2_full = serMul(Tpoly, Tpoly, 45);
list A2_full = serMul(Apoly, Apoly, 27);
list pA2_0 = serMul(pLpoly, A2_full, 45);
poly eq26_0 = T2_full[27] - 9 * pA2_0[27];
pLpoly[1] = eq26_0 / number(9);
printf("[%s ms] Eliminated p0 (terms=%s)", timer - t0_clk, size(pLpoly[1]));

// Test 1: ODE + R2 + sq[30..27] + w*b2 - 1 (smallest core!)
ideal I_ode = R2, ode[12], w * b2 - 1, sq[31], sq[30], sq[29], sq[28];
for (kk = 0; kk <= 6; kk++) { I_ode = I_ode, ode[kk + 1]; }
printf("[%s ms] Testing slimgb(I_ode) (14 eqs, 11 vars) over F_32003...", timer - t0_clk);
ideal G_ode = slimgb(I_ode);
printf("[%s ms] slimgb(I_ode): size=%s, dim=%s, G_ode[1]=%s", timer - t0_clk, size(G_ode), dim(G_ode), G_ode[1]);

if (size(G_ode) == 1 && G_ode[1] == 1) {
  printf("F_32003_CORE_UNSAT: I_ode ALONE IS [1] MOD 32003!");
  quit;
}

// Test 2: Full system including sqFull[25..0]
list pA2_full = serMul(pLpoly, A2_full, 45);
ideal I_full = G_ode;
for (kk = 0; kk <= 25; kk++) {
  poly cc = T2_full[kk + 1] - 9 * pA2_full[kk + 1];
  if (kk <= 8) { cc = cc - Mpoly[kk + 1]; }
  I_full = I_full, cc;
}
printf("[%s ms] Testing slimgb(I_full) over F_32003...", timer - t0_clk);
ideal G_full = slimgb(I_full);
printf("[%s ms] slimgb(I_full): size=%s, dim=%s, G_full[1]=%s", timer - t0_clk, size(G_full), dim(G_full), G_full[1]);

if (size(G_full) == 1 && G_full[1] == 1) {
  printf("F_32003_FULL_UNSAT: L-ALONE SYSTEM IS [1] MOD 32003!");
} else {
  printf("F_32003_NONEMPTY: dim=%s, mult=%s", dim(G_full), mult(G_full));
  int lim = size(G_full);
  if (lim > 15) { lim = 15; }
  for (kk = 1; kk <= lim; kk++) {
    printf("  G_full[%s]: deg=%s, terms=%s", kk, deg(G_full[kk]), size(G_full[kk]));
  }
}
quit;
