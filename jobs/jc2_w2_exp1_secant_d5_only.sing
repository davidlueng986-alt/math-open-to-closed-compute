// Pure-Singular COMPLETE EXACT Q-PROOF for SECANT-HEIGHT-FOUR-REALIZATION at d = 5 (j = 4)!
// Uses EXACT algebraic factorization of ODE[V^0] & ODE[V^1] into 5 exhaustive branches (cutting deg 20 -> deg 9..11!):
//   Branch 0a: c0 = 0, x0 = 0, x1 = 0
//   Branch 0b: c0 = 0, x0 = 0, x1 = m2
//   Branch 1 : 4*x0 - c0^2 = 0, (c0 - 3*m3)*x1 - c0*m2 = 0
//   Branch 2a: 4*x0 - c0^2 + 2*c0*m3 = 0, x1 - m2 = 0
//   Branch 2b: c0 + m3 = 0, 4*x0 - 3*m3^2 = 0
// Covers ALL m2 in C: Case 1 (m2 = 1) and Case 2 (m2 = 0, subcases c4=1; c4=0,c3=1; c4=c3=0,c2=1)!
// Tests BOTH ODE ALONE and ODE + (m0*m3 + m1*m2 = 0), with F_32009 + exact Q-verified modStd(I, 1)!

LIB "modstd.lib";
option(prot);

proc getc(matrix M, int k) {
  if (k < 0 || nrows(M) <= k) { return(poly(0)); }
  return(M[k + 1, 1]);
}

proc redS(poly f, int D) {
  if (f == 0) { return(poly(0)); }
  matrix C = coeffs(f, s);
  int nr = nrows(C);
  poly res0 = 0;
  poly res1 = 0;
  number pD = 1;
  int k;
  for (k = 0; k < nr; k++) {
    if (k % 2 == 0) {
      res0 = res0 + C[k + 1, 1] * pD;
    } else {
      res1 = res1 + C[k + 1, 1] * pD;
      pD = pD * number(D);
    }
  }
  return(res0 + res1 * s);
}

proc invLinS(number A, number B, int D) {
  number den = A*A - number(D)*B*B;
  return((A - B*s) / den);
}

ring R5u = 0, (V, c4, c3, c2, c0, m3, m2, m1, m0, s), dp;

poly a1 = V^5 + c4*V^4 + c3*V^3 + c2*V^2 + c0;
poly RHS = 3*(a1^4 - 2*m3*a1^3 + 4*m2*V*a1^2 - 8*m1*V^2*a1 + 16*m0*V^3);
poly Q = (number(3)/number(2))*a1^2 - (number(3)/number(2))*m3*a1 + m2*V;

matrix rhsc = coeffs(RHS, V);
matrix qc = coeffs(Q, V);

matrix xc[11][1];
xc[11, 1] = redS(number(3)/number(4) * invLinS(number(3), number(2), 15), 15);

int k, dg, ii, jj;
poly lhs_rest, term, qcur, invpiv;
for (k = 1; k <= 10; k++) {
  dg = 20 - k;
  lhs_rest = 0;
  for (ii = 10 - k + 1; ii <= 10; ii++) {
    jj = dg - ii;
    if (jj != 10 - k && jj >= 0 && jj <= 10) {
      term = number(2*jj - 3)*xc[jj+1, 1] + getc(qc, jj);
      if (term != 0 && xc[ii+1, 1] != 0) {
        lhs_rest = lhs_rest + 16 * xc[ii+1, 1] * term;
      }
    }
  }
  qcur = getc(qc, 10 - k);
  if (qcur != 0) {
    lhs_rest = lhs_rest + 16 * xc[11, 1] * qcur;
  }
  invpiv = redS((number(3) + number(2)*s) * invLinS(number(20 - k), number(2), 15) / number(24), 15);
  xc[10 - k + 1, 1] = redS((getc(rhsc, dg) - lhs_rest) * invpiv, 15);
}

poly X = 0;
for (k = 0; k <= 10; k++) { X = X + xc[k+1, 1] * V^k; }
poly ODE = 16*X*(2*V*diff(X, V) - 3*X + Q) - RHS;
matrix odec = coeffs(ODE, V);
for (k = 10; k <= 20; k++) {
  if (redS(getc(odec, k), 15) != 0) { printf("ERROR: d=5 ODE nonzero at V^%s!", k); quit; }
}
printf("d=5: ODE[V^10..V^20] identically 0 mod (s^2-15)!");

poly eq7 = redS(getc(odec, 7), 15);
if (diff(eq7, m1) != number(24)) { printf("ERROR: m1 pivot!"); quit; }
poly m1_sol = -subst(eq7, m1, 0) / number(24);

poly eq3 = redS(subst(getc(odec, 3), m1, m1_sol), 15);
if (diff(eq3, m0) != number(-48)) { printf("ERROR: m0 pivot!"); quit; }
poly m0_sol = subst(eq3, m0, 0) / number(48);

poly x0_p = xc[1, 1];
poly x1_p = xc[2, 1];

// Core equations ODE[V^9, V^8, V^6, V^5, V^4, V^2] + (s^2 - 15)
ideal I_core =
  redS(getc(odec, 9), 15),
  redS(getc(odec, 8), 15),
  redS(subst(getc(odec, 6), m1, m1_sol), 15),
  redS(subst(getc(odec, 5), m1, m1_sol), 15),
  redS(subst(getc(odec, 4), m1, m1_sol), 15),
  redS(subst(getc(odec, 2), m1, m1_sol), 15),
  s^2 - 15;
poly eq_mu = redS(m0_sol * m3 + m1_sol * m2, 15);

// 5 exhaustive V=0 branch pairs:
ideal B0a = c0, x0_p, x1_p;
ideal B0b = c0, x0_p, x1_p - m2;
ideal B1  = 4*x0_p - c0^2, redS((c0 - 3*m3)*x1_p - c0*m2, 15);
ideal B2a = 4*x0_p - c0^2 + 2*c0*m3, x1_p - m2;
ideal B2b = c0 + m3, 4*x0_p - 3*m3^2;

// Helper ring for testing each branch over F_32009 and exact Q modStd(I, 1)!
ring Rq = 0, (c4, c3, c2, c0, m3, s), wp(1, 2, 3, 5, 5, 1);
ring Rp = 32009, (c4, c3, c2, c0, m3, s), wp(1, 2, 3, 5, 5, 1);

proc testBranch(string label, ideal I_ode_q, poly mu_q) {
  setring Rp;
  ideal Iop = imap(Rq, I_ode_q);
  ideal Gop = slimgb(Iop);
  if (size(Gop) == 1 && Gop[1] == 1) {
    printf("  [%s] F_32009 ODE ALONE = [1]! Running exact Q modStd(I, 1)...", label);
    setring Rq;
    ideal Goq = modStd(I_ode_q, 1);
    if (size(Goq) == 1 && Goq[1] == 1) {
      printf("  CERTIFIED_MODSTD_Q [%s]: ODE_ALONE_EMPTY!", label);
    } else {
      printf("  WARNING [%s]: Q modStd ODE ALONE size=%s, G[1]=%s", label, size(Goq), Goq[1]);
    }
    return();
  }
  printf("  [%s] F_32009 ODE ALONE: size=%s, G[1]=%s, dim=%s, vdim=%s",
         label, size(Gop), Gop[1], dim(Gop), vdim(Gop));
  ideal Icp = Iop, imap(Rq, mu_q);
  ideal Gcp = slimgb(Icp);
  if (size(Gcp) == 1 && Gcp[1] == 1) {
    printf("  [%s] F_32009 COUPLED = [1]! Running exact Q modStd(I, 1)...", label);
    setring Rq;
    ideal Ic_q = I_ode_q, mu_q;
    ideal Gcq = modStd(Ic_q, 1);
    if (size(Gcq) == 1 && Gcq[1] == 1) {
      printf("  CERTIFIED_MODSTD_Q [%s]: COUPLED_EMPTY!", label);
    } else {
      printf("  WARNING [%s]: Q modStd COUPLED size=%s, G[1]=%s", label, size(Gcq), Gcq[1]);
    }
    return();
  }
  printf("  [%s] F_32009 COUPLED: size=%s, G[1]=%s, dim=%s, vdim=%s",
         label, size(Gcp), Gcp[1], dim(Gcp), vdim(Gcp));
}

// ======================== CASE 1: m2 = 1 ========================
printf("============================================================");
printf("CASE 1: d = 5 (j = 4), m2 = 1 (all m2 != 0)");
printf("============================================================");
setring R5u;
ideal C1_0a = subst(I_core + B0a, m2, 1);
ideal C1_0b = subst(I_core + B0b, m2, 1);
ideal C1_1  = subst(I_core + B1,  m2, 1);
ideal C1_2a = subst(I_core + B2a, m2, 1);
ideal C1_2b = subst(I_core + B2b, m2, 1);
poly  M1    = subst(eq_mu, m2, 1);

setring Rq;
testBranch("m2=1 / B0a", imap(R5u, C1_0a), imap(R5u, M1));
testBranch("m2=1 / B0b", imap(R5u, C1_0b), imap(R5u, M1));
testBranch("m2=1 / B2b", imap(R5u, C1_2b), imap(R5u, M1));
testBranch("m2=1 / B2a", imap(R5u, C1_2a), imap(R5u, M1));
testBranch("m2=1 / B1 ", imap(R5u, C1_1),  imap(R5u, M1));

// ======================== CASE 2: m2 = 0 (3 subcases) ========================
printf("============================================================");
printf("CASE 2: d = 5 (j = 4), m2 = 0 (a1 not in C[V^5])");
printf("============================================================");
setring R5u;
ideal C2_0a = subst(I_core + B0a, m2, 0);
ideal C2_0b = subst(I_core + B0b, m2, 0);
ideal C2_1  = subst(I_core + B1,  m2, 0);
ideal C2_2a = subst(I_core + B2a, m2, 0);
ideal C2_2b = subst(I_core + B2b, m2, 0);
poly  M2    = subst(eq_mu, m2, 0);

setring Rq;
ideal I2_0a = imap(R5u, C2_0a);
ideal I2_0b = imap(R5u, C2_0b);
ideal I2_1  = imap(R5u, C2_1);
ideal I2_2a = imap(R5u, C2_2a);
ideal I2_2b = imap(R5u, C2_2b);
poly  M2q   = imap(R5u, M2);

testBranch("m2=0,c4=1 / B0a", subst(I2_0a, c4, 1), subst(M2q, c4, 1));
testBranch("m2=0,c4=1 / B0b", subst(I2_0b, c4, 1), subst(M2q, c4, 1));
testBranch("m2=0,c4=1 / B2b", subst(I2_2b, c4, 1), subst(M2q, c4, 1));
testBranch("m2=0,c4=1 / B2a", subst(I2_2a, c4, 1), subst(M2q, c4, 1));
testBranch("m2=0,c4=1 / B1 ", subst(I2_1,  c4, 1), subst(M2q, c4, 1));

testBranch("m2=0,c4=0,c3=1 / B0a", subst(subst(I2_0a, c4, 0), c3, 1), subst(subst(M2q, c4, 0), c3, 1));
testBranch("m2=0,c4=0,c3=1 / B0b", subst(subst(I2_0b, c4, 0), c3, 1), subst(subst(M2q, c4, 0), c3, 1));
testBranch("m2=0,c4=0,c3=1 / B2b", subst(subst(I2_2b, c4, 0), c3, 1), subst(subst(M2q, c4, 0), c3, 1));
testBranch("m2=0,c4=0,c3=1 / B2a", subst(subst(I2_2a, c4, 0), c3, 1), subst(subst(M2q, c4, 0), c3, 1));
testBranch("m2=0,c4=0,c3=1 / B1 ", subst(subst(I2_1,  c4, 0), c3, 1), subst(subst(M2q, c4, 0), c3, 1));

testBranch("m2=0,c4=c3=0,c2=1 / B0a", subst(subst(subst(I2_0a, c4, 0), c3, 0), c2, 1), subst(subst(subst(M2q, c4, 0), c3, 0), c2, 1));
testBranch("m2=0,c4=c3=0,c2=1 / B0b", subst(subst(subst(I2_0b, c4, 0), c3, 0), c2, 1), subst(subst(subst(M2q, c4, 0), c3, 0), c2, 1));
testBranch("m2=0,c4=c3=0,c2=1 / B2b", subst(subst(subst(I2_2b, c4, 0), c3, 0), c2, 1), subst(subst(subst(M2q, c4, 0), c3, 0), c2, 1));
testBranch("m2=0,c4=c3=0,c2=1 / B2a", subst(subst(subst(I2_2a, c4, 0), c3, 0), c2, 1), subst(subst(subst(M2q, c4, 0), c3, 0), c2, 1));
testBranch("m2=0,c4=c3=0,c2=1 / B1 ", subst(subst(subst(I2_1,  c4, 0), c3, 0), c2, 1), subst(subst(subst(M2q, c4, 0), c3, 0), c2, 1));

printf("ALL_D5_BRANCHES_COMPLETED");
quit;
