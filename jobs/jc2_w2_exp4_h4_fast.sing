// Fast Exact Q Singular Proofs for SECANT-HEIGHT-FOUR-REALIZATION:
//   (A) d = 5 (j = 4), a0 = 0 (mu3 = mu1 = 0 by all-d theorem, mu2 = 1, a5 = 1):
//       Bottom-up constant pivots 16*(2k-1) => ONLY 4 variables (mu0, a2, a3, a4)!
//   (B) d = 6 (j = 5), a0 = 0 (mu3 = mu1 = 0, mu2 = 1, a6 = 1):
//       ONLY 5 variables (mu0, a2, a3, a4, a5)!
//   (C) d = 5 (j = 4), a0 = 1 (general a0 != 0, mu2 = 1, mu1 = -mu0*mu3):
//       Direct degree-4 ODE with x0=(1-2*mu3)/4, x1=1, weighted ordering wp!

LIB "modstd.lib";
system("--ticks-per-sec", 1000);
int t0_clk = timer;

proc polyMul(list A, list B) {
  int na = size(A);
  int nb = size(B);
  list C;
  int i, j;
  for (i = 1; i <= na + nb - 1; i++) { C[i] = poly(0); }
  for (i = 1; i <= na; i++) {
    if (A[i] == 0) { continue; }
    for (j = 1; j <= nb; j++) {
      if (B[j] == 0) { continue; }
      C[i + j - 1] = C[i + j - 1] + A[i] * B[j];
    }
  }
  return(C);
}

// =========================================================================
// (A) d = 5 (j = 4), a0 = 0, mu3 = mu1 = 0, mu2 = 1, a5 = 1 (4 vars!)
// =========================================================================
ring R5z = 0, (mu0, a2, a3, a4), wp(17, 3, 2, 1);
list a1_5 = list(poly(0), poly(0), a2, a3, a4, poly(1));
list a1_5_2 = polyMul(a1_5, a1_5);
list a1_5_4 = polyMul(a1_5_2, a1_5_2);

list RHS5;
int m;
for (m = 0; m <= 20; m++) {
  poly cc = a1_5_4[m + 1];
  if (m >= 1 && m <= 11) { cc = cc + 4 * a1_5_2[m]; }
  if (m == 3)            { cc = cc + 16 * mu0; }
  RHS5[m + 1] = 3 * cc;
}
list P5;
for (m = 0; m <= 10; m++) {
  poly cc = (number(3) / number(2)) * a1_5_2[m + 1];
  if (m == 1) { cc = cc + poly(1); }
  P5[m + 1] = cc;
}

// Bottom-up solve X5[k+1] for k = 2..10 from V^{k+1} (pivot 16*(2k - 3) + 16*2? Check!)
// Wait: X = V + x2*V^2 + ..., Y = 2*V*X' - 3*X + P5 = -V + (2-3)*x2*V^2 + ... + (2k-3)*x_k*V^k + ... + V + ...
// At V^{k+1}: 16*(1 * (2k-3)*x_k + x_k * (2*1 - 3 + 1)) = 16*(2k-3)*x_k! Wait: check at k=2:
// Y[2] (coeff of V^1) = (2*1 - 3)*1 + 1 = 0! So X_k * Y[2] = 0!
// Only X[2] * Y[k+1] = 1 * (2k - 3) * x_k contributes! Wait: 16*(2k - 3) = 16, 48, 80, ...!
list X5;
for (m = 1; m <= 11; m++) { X5[m] = poly(0); }
X5[2] = poly(1);
int k, i, j;
for (k = 2; k <= 10; k++) {
  int d_eq = k + 1;
  poly rest = 0;
  for (i = 1; i <= k - 1; i++) {
    j = d_eq - i;
    if (j >= 1 && j <= k - 1) {
      poly yj = number(2 * j - 3) * X5[j + 1] + P5[j + 1];
      rest = rest + 16 * X5[i + 1] * yj;
    }
  }
  // i = 1, j = k contributes 16 * 1 * ((2k-3)*x_k + P5[k+1])
  rest = rest + 16 * P5[k + 1];
  X5[k + 1] = (RHS5[d_eq + 1] - rest) / number(16 * (2 * k - 3));
}
list Y5;
for (m = 0; m <= 10; m++) { Y5[m + 1] = number(2 * m - 3) * X5[m + 1] + P5[m + 1]; }
list L5 = polyMul(X5, Y5);
ideal I5z = 0;
for (m = 0; m <= 20; m++) {
  poly eqm = 16 * L5[m + 1] - RHS5[m + 1];
  if (m <= 11 && eqm != 0) { printf("ERROR A: eq[%s] nonzero!", m); quit; }
  if (m >= 12) { I5z = I5z, eqm; }
}
I5z = simplify(I5z, 2);
printf("[%s ms] (A) Built d=5 a0=0 ideal (9 eqs in 4 vars). Running modStd over EXACT Q...", timer - t0_clk);
ideal G5z = modStd(I5z, 1);
printf("[%s ms] (A) EXACT Q G5z: size=%s, G5z[1]=%s", timer - t0_clk, size(G5z), G5z[1]);
if (size(G5z) == 1 && G5z[1] == 1) {
  printf("CERTIFIED_Q_EXACT: H4_D5_A0_ZERO_EMPTY_OVER_C");
}

// =========================================================================
// (B) d = 6 (j = 5), a0 = 0, mu3 = mu1 = 0, mu2 = 1, a6 = 1 (5 vars!)
// =========================================================================
ring R6z = 0, (mu0, a2, a3, a4, a5), wp(21, 4, 3, 2, 1);
list a1_6 = list(poly(0), poly(0), a2, a3, a4, a5, poly(1));
list a1_6_2 = polyMul(a1_6, a1_6);
list a1_6_4 = polyMul(a1_6_2, a1_6_2);

list RHS6;
for (m = 0; m <= 24; m++) {
  poly cc = a1_6_4[m + 1];
  if (m >= 1 && m <= 13) { cc = cc + 4 * a1_6_2[m]; }
  if (m == 3)            { cc = cc + 16 * mu0; }
  RHS6[m + 1] = 3 * cc;
}
list P6;
for (m = 0; m <= 12; m++) {
  poly cc = (number(3) / number(2)) * a1_6_2[m + 1];
  if (m == 1) { cc = cc + poly(1); }
  P6[m + 1] = cc;
}
list X6;
for (m = 1; m <= 13; m++) { X6[m] = poly(0); }
X6[2] = poly(1);
for (k = 2; k <= 12; k++) {
  int d_eq = k + 1;
  poly rest = 0;
  for (i = 1; i <= k - 1; i++) {
    j = d_eq - i;
    if (j >= 1 && j <= k - 1) {
      poly yj = number(2 * j - 3) * X6[j + 1] + P6[j + 1];
      rest = rest + 16 * X6[i + 1] * yj;
    }
  }
  rest = rest + 16 * P6[k + 1];
  X6[k + 1] = (RHS6[d_eq + 1] - rest) / number(16 * (2 * k - 3));
}
list Y6;
for (m = 0; m <= 12; m++) { Y6[m + 1] = number(2 * m - 3) * X6[m + 1] + P6[m + 1]; }
list L6 = polyMul(X6, Y6);
ideal I6z = 0;
for (m = 0; m <= 24; m++) {
  poly eqm = 16 * L6[m + 1] - RHS6[m + 1];
  if (m <= 13 && eqm != 0) { printf("ERROR B: eq[%s] nonzero!", m); quit; }
  if (m >= 14) { I6z = I6z, eqm; }
}
I6z = simplify(I6z, 2);
printf("[%s ms] (B) Built d=6 a0=0 ideal (11 eqs in 5 vars). Running modStd over EXACT Q...", timer - t0_clk);
ideal G6z = modStd(I6z, 1);
printf("[%s ms] (B) EXACT Q G6z: size=%s, G6z[1]=%s", timer - t0_clk, size(G6z), G6z[1]);
if (size(G6z) == 1 && G6z[1] == 1) {
  printf("CERTIFIED_Q_EXACT: H4_D6_A0_ZERO_EMPTY_OVER_C");
}
quit;
