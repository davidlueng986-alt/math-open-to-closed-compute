// Pure-Singular EXACT Q-PROOF for SECANT-HEIGHT-FOUR-REALIZATION at d = 5 (j = 4, minimal survivor!)
// ODE: 16*X*(2*V*X' - 3*X + 3/2*a1^2 - 3/2*mu3*a1 + mu2*V) = 3*(a1^4 - 2*mu3*a1^3 + 4*mu2*V*a1^2 - 8*mu1*V^2*a1 + 16*mu0*V^3)
// Normalized c5 = 1, mu2 = 1 (valid since c5 != 0 and mu2 != 0), a1'(0) = 0 -> a1 = V^5 + c4*V^4 + c3*V^3 + c2*V^2 + c0.
// Leading coeff of X is kap with 272*kap^2 + 24*kap - 3 = 0.
// Tests BOTH:
//   (A) Coupled with mu0*mu3 + mu1*mu2 = 0 (i.e. mu1 = -mu0*mu3) -> 6 vars (c4, c3, c2, c0, mu3, mu0) over Q(kap)
//   (B) Pure ODE (mu1 free, mu2 = 1) -> 7 vars (c4, c3, c2, c0, mu3, mu1, mu0) over Q(kap)

LIB "modstd.lib";

proc vcoeff(poly f, int k) {
  matrix C = coeffs(f, V);
  if (k + 1 > nrows(C)) { return(poly(0)); }
  return(C[k + 1, 1]);
}

ring Rv = (0, kap), (V, c4, c3, c2, c0, mu3, mu1, mu0), dp;
minpoly = 272*kap^2 + 24*kap - 3;

poly a1 = V^5 + c4*V^4 + c3*V^3 + c2*V^2 + c0;
poly RHS = 3*(a1^4 - 2*mu3*a1^3 + 4*V*a1^2 - 8*mu1*V^2*a1 + 16*mu0*V^3);
poly B = (number(3)/number(2))*a1^2 - (number(3)/number(2))*mu3*a1 + V;

list xc;
int k, m, dg, i, j;
for (k = 1; k <= 11; k++) { xc[k] = poly(0); }
xc[11] = poly(kap);

for (m = 1; m <= 10; m++) {
  dg = 20 - m;
  poly Xcur = 0;
  for (k = 10 - m + 1; k <= 10; k++) { Xcur = Xcur + xc[k + 1] * V^k; }
  poly curLHS = 16 * Xcur * (2*V*diff(Xcur, V) - 3*Xcur + B);
  poly rem = vcoeff(RHS, dg) - vcoeff(curLHS, dg);
  number piv = 16 * ((34 - 2*m)*kap + number(3)/number(2));
  xc[10 - m + 1] = rem / piv;
}

poly X = 0;
for (k = 0; k <= 10; k++) { X = X + xc[k + 1] * V^k; }
poly odeDiff = 16*X*(2*V*diff(X, V) - 3*X + B) - RHS;

for (k = 10; k <= 20; k++) {
  if (vcoeff(odeDiff, k) != 0) { printf("ERROR: odeDiff nonzero at %s!", k); quit; }
}
printf("Verified d=5 ODE vanishes identically at degrees 10..20!");

ideal I_all_v =
  vcoeff(odeDiff, 9), vcoeff(odeDiff, 8), vcoeff(odeDiff, 7), vcoeff(odeDiff, 6), vcoeff(odeDiff, 5),
  vcoeff(odeDiff, 4), vcoeff(odeDiff, 3), vcoeff(odeDiff, 2), vcoeff(odeDiff, 1), vcoeff(odeDiff, 0);

// === CASE A: Coupled with mu0*mu3 + mu1*mu2 = 0 (mu1 = -mu0*mu3) ===
printf("=== CASE A: d=5 (j=4) WITH mu0*mu3 + mu1*mu2 = 0 (6 vars over Q(kap)) ===");
ideal I_A_v = subst(I_all_v, mu1, -mu0*mu3);

ring RA = (0, kap), (c4, c3, c2, c0, mu3, mu0), dp;
minpoly = 272*kap^2 + 24*kap - 3;
ideal IA = imap(Rv, I_A_v);

printf("Running slimgb(IA) directly over Q(kap)...");
ideal GA = slimgb(IA);
printf("Q(kap) slimgb(IA) size = %s, dim = %s, GA[1] = %s", size(GA), dim(GA), GA[1]);
if (size(GA) == 1 && GA[1] == 1) {
  printf("CERTIFIED_Q_KAP_A: SECANT_H4_D5_COUPLED_PROVED_EMPTY_OVER_C");
} else {
  if (dim(GA) == 0) { printf("vdim(GA) = %s", vdim(GA)); }
}

// === CASE B: Pure ODE WITHOUT mu0*mu3 + mu1*mu2 = 0 (7 vars over Q(kap)) ===
printf("=== CASE B: d=5 (j=4) PURE ODE (mu2=1, mu1 free, 7 vars over Q(kap)) ===");
ring RB = (0, kap), (c4, c3, c2, c0, mu3, mu1, mu0), dp;
minpoly = 272*kap^2 + 24*kap - 3;
ideal IB = imap(Rv, I_all_v);

printf("Running slimgb(IB) directly over Q(kap)...");
ideal GB = slimgb(IB);
printf("Q(kap) slimgb(IB) size = %s, dim = %s, GB[1] = %s", size(GB), dim(GB), GB[1]);
if (size(GB) == 1 && GB[1] == 1) {
  printf("CERTIFIED_Q_KAP_B: SECANT_H4_D5_PURE_ODE_PROVED_EMPTY_OVER_C");
} else {
  if (dim(GB) == 0) { printf("vdim(GB) = %s", vdim(GB)); }
}
quit;
