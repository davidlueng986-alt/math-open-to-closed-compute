// Wave 2 Explorer 6: DEGREE-135-IV-GCD-FOUR fast F_32003 structural & emptiness probe
// Exact L-alone system with n4 = 0 (translation) and l = 1 (scaling):
//   deg r = 4, deg N = 5, deg M = 8, deg g = 4, deg A = 13, deg T = 22, deg pL = 18, deg B = 9
//   10 exact constant-pivot rational eliminations:
//     n0 (-54), a3 (-81/16), a2 (-81/7), a1 (-81/4), a0 (-162/5), t4..t0 (9,9,9,9,9)
//   Leaves 10 vars (p0, a4, v6, r3, r2, r1, r0, n3, n2, n1) + w for w*b2 - 1 = 0.

proc ucoeff(poly f, int k) {
  matrix C = coeffs(f, u);
  if (k + 1 > nrows(C)) { return(poly(0)); }
  return(C[k + 1, 1]);
}

proc udiv_q(poly F, poly D, int degF, int degD) {
  poly rem = F;
  poly q = 0;
  int k;
  for (k = degF; k >= degD; k--) {
    poly c = ucoeff(rem, k);
    if (c != 0) {
      q = q + c * u^(k - degD);
      rem = rem - c * u^(k - degD) * D;
    }
  }
  return(q);
}

ring Ru = 32003, (u, p0, t4, t3, t2, t1, t0, a4, a3, a2, a1, a0, w, v6, r3, r2, r1, r0, n3, n2, n1, n0), dp;

poly r = u^4 + r3*u^3 + r2*u^2 + r1*u + r0;
poly N = u^5 + n3*u^3 + n2*u^2 + n1*u + n0;

number b9 = number(9)/number(2);
poly b6 = number(9)/number(8) * (4*v6 - 13);
poly v3 = number(3)/number(500) * (500*v6 - 1001);
poly b3 = number(27)/number(500) * (377 - 125*v6);

// 1. B(u) and r | B'
poly N3 = N^3;
poly numB = b9*r^6 + b6*r^4*N + b3*r^2*N^2;
poly QB = udiv_q(numB, N3, 24, 15);
poly dQB = diff(QB, u);
poly g_init = udiv_q(dQB, r, 8, 4);
poly rem_r = dQB - g_init * r;

poly d3 = ucoeff(rem_r, 3);
poly d2 = ucoeff(rem_r, 2);
poly d1 = ucoeff(rem_r, 1);
poly d0 = ucoeff(rem_r, 0);

if (diff(d3, n0) != -54) { printf("ERROR: d3 n0 pivot mismatch!"); quit; }
poly n0_sol = subst(d3, n0, 0) / number(54);

// Substitute n0_sol immediately!
N = subst(N, n0, n0_sol);
N3 = N^3;
d2 = subst(d2, n0, n0_sol);
d1 = subst(d1, n0, n0_sol);
d0 = subst(d0, n0, n0_sol);
poly g = subst(g_init, n0, n0_sol);

poly c2 = -d1 / number(2);
poly c1 = -d0;
poly b2 = c2;
poly b1 = c1 - number(4)/number(3)*r3*b2;
poly v2 = number(2)/number(9)*b2;
poly v1 = number(2)/number(9)*b1;

printf("Stage 1 done: n0 eliminated, deg g = 4, d2 terms = %s", size(d2));

// 2. Construct A(u) = r*V(u) of degree 13
poly numA = r^7 + v6*r^5*N + v3*r^3*N^2;
poly QA = udiv_q(numA, N3, 28, 15);
poly extraA = r * (v2*(u^2 + number(4)/number(3)*r3*u) + v1*u);
poly A = a4*u^4 + a3*u^3 + a2*u^2 + a1*u + a0;
int k;
for (k = 5; k <= 13; k++) {
  A = A + ucoeff(QA, k) * u^k;
}
for (k = 5; k <= 6; k++) {
  A = A + ucoeff(extraA, k) * u^k;
}

// 3. Solve ODE 2*M*T' - M'*T = 18*A*(A'*r - A*r') for T[22..5]
poly M = r^2 + N;
poly dM = diff(M, u);
poly mcoeff[9];
for (k = 0; k <= 8; k++) { mcoeff[k+1] = ucoeff(M, k); }

poly RHS = 18 * A * (diff(A, u)*r - A*diff(r, u));
poly tcoeff[23];
for (k = 1; k <= 23; k++) { tcoeff[k] = 0; }
int j, ii, d;
for (k = 22; k >= 5; k--) {
  d = k + 7;
  poly lhs_rest = 0;
  for (j = 0; j <= 7; j++) {
    ii = d + 1 - j;
    if (ii >= 5 && ii <= 22) {
      lhs_rest = lhs_rest + tcoeff[ii+1] * (2*ii - j) * mcoeff[j+1];
    }
  }
  tcoeff[k+1] = (ucoeff(RHS, d) - lhs_rest) / number(2*k - 8);
}

poly Thi = 0;
for (k = 5; k <= 22; k++) { Thi = Thi + tcoeff[k+1] * u^k; }

// Check odeDiff at degrees 29..12
poly odeDiff_hi = 2*M*diff(Thi, u) - dM*Thi - RHS;
for (k = 12; k <= 29; k++) {
  if (ucoeff(odeDiff_hi, k) != 0) { printf("ERROR: odeDiff_hi nonzero at %s!", k); quit; }
}
printf("Stage 2 done: odeDiff_hi[12..29] == 0 verified!");

// 4. Compute sqDiff[34..31] and eliminate a3, a2, a1, a0
poly gA = g * A;
poly pL0 = 0;
for (k = 0; k <= 17; k++) {
  pL0 = pL0 + ucoeff(gA, k) * u^(k+1) / number(k+1);
}
poly sqDiff_hi = Thi^2 - 9*pL0*A^2;
for (k = 35; k <= 44; k++) {
  if (ucoeff(sqDiff_hi, k) != 0) { printf("ERROR: sqDiff_hi nonzero at %s!", k); quit; }
}
printf("Stage 3 done: sqDiff_hi[35..44] == 0 verified!");

poly eq34 = ucoeff(sqDiff_hi, 34);
poly eq33 = ucoeff(sqDiff_hi, 33);
poly eq32 = ucoeff(sqDiff_hi, 32);
poly eq31 = ucoeff(sqDiff_hi, 31);

if (diff(eq34, a3) != number(-81)/number(16)) { printf("ERROR: a3 pivot!"); quit; }
poly a3_sol = subst(eq34, a3, 0) * (number(16)/number(81));

eq33 = subst(eq33, a3, a3_sol);
if (diff(eq33, a2) != number(-81)/number(7)) { printf("ERROR: a2 pivot!"); quit; }
poly a2_sol = subst(eq33, a2, 0) * (number(7)/number(81));

eq32 = subst(subst(eq32, a3, a3_sol), a2, a2_sol);
if (diff(eq32, a1) != number(-81)/number(4)) { printf("ERROR: a1 pivot!"); quit; }
poly a1_sol = subst(eq32, a1, 0) * (number(4)/number(81));

eq31 = subst(subst(subst(eq31, a3, a3_sol), a2, a2_sol), a1, a1_sol);
if (diff(eq31, a0) != number(-162)/number(5)) { printf("ERROR: a0 pivot!"); quit; }
poly a0_sol = subst(eq31, a0, 0) * (number(5)/number(162));

printf("Stage 4 done: a3, a2, a1, a0 eliminated with exact constant pivots!");

// Re-substitute a3..a0 into A, recompute T[22..5], pL0, f30..f27, ode11
A = subst(subst(subst(subst(A, a3, a3_sol), a2, a2_sol), a1, a1_sol), a0, a0_sol);
RHS = 18 * A * (diff(A, u)*r - A*diff(r, u));
for (k = 22; k >= 5; k--) {
  d = k + 7;
  poly lhs_rest = 0;
  for (j = 0; j <= 7; j++) {
    ii = d + 1 - j;
    if (ii >= 5 && ii <= 22) {
      lhs_rest = lhs_rest + tcoeff[ii+1] * (2*ii - j) * mcoeff[j+1];
    }
  }
  tcoeff[k+1] = (ucoeff(RHS, d) - lhs_rest) / number(2*k - 8);
}
Thi = 0;
for (k = 5; k <= 22; k++) { Thi = Thi + tcoeff[k+1] * u^k; }

gA = g * A;
pL0 = 0;
for (k = 0; k <= 17; k++) {
  pL0 = pL0 + ucoeff(gA, k) * u^(k+1) / number(k+1);
}
poly pL = pL0 + p0;
poly A2 = A^2;
poly pLA2 = 9 * pL * A2;

// Extract f30..f27 and ode11
poly sqHi = Thi^2 - pLA2;
poly f30 = ucoeff(sqHi, 30);
poly f29 = ucoeff(sqHi, 29);
poly f28 = ucoeff(sqHi, 28);
poly f27 = ucoeff(sqHi, 27);
poly odeDiff11 = 2*M*diff(Thi, u) - dM*Thi - RHS;
poly ode11 = ucoeff(odeDiff11, 11);

// Stage 5: Solve t4..t0 from sqDiff[26..22] with constant pivot 9!
poly Tfull = Thi;
poly curSq = sqHi;
for (k = 4; k >= 0; k--) {
  // coeff of u^(22+k) in (Tfull + tk*u^k)^2 - pLA2 is coeff(curSq, 22+k) + 9*tk
  poly eqk = ucoeff(curSq, 22 + k);
  poly tk_sol = -eqk / number(9);
  tcoeff[k+1] = tk_sol;
  Tfull = Tfull + tk_sol * u^k;
  curSq = Tfull^2 - pLA2;
  if (ucoeff(curSq, 22 + k) != 0) { printf("ERROR: t%s elim failed!", k); quit; }
}
printf("Stage 5 done: t4..t0 eliminated with constant pivot 9!");

// Remaining ODE equations ode10..ode0 and sqDiff equations eq21..eq9 and eq8..eq0 - M
poly odeFull = 2*M*diff(Tfull, u) - dM*Tfull - RHS;
poly sqFull = Tfull^2 - pLA2 - M;

ideal Iu = d2, f30, f29, f28, f27, ode11, w*b2 - 1;
for (k = 10; k >= 0; k--) {
  Iu = Iu, ucoeff(odeFull, k);
}
for (k = 21; k >= 0; k--) {
  Iu = Iu, ucoeff(sqFull, k);
}
printf("Built full reduced ideal Iu in 11 vars! size(Iu) = %s", size(Iu));
for (k = 1; k <= 12; k++) {
  printf("  gen %s: deg=%s, terms=%s", k, deg(Iu[k]), size(Iu[k]));
}

// Map to 11-var ring over F_32003
ring R11 = 32003, (p0, a4, w, v6, r3, r2, r1, r0, n3, n2, n1), dp;
ideal I11 = imap(Ru, Iu);

printf("=== Running slimgb(I11) over F_32003 (with w*b2 - 1) ===");
option(prot);
ideal G11 = slimgb(I11);
printf("F_32003 slimgb(I11) size = %s, dim = %s, vdim = %s", size(G11), dim(G11), vdim(G11));
printf("G11[1] = %s", G11[1]);
quit;
