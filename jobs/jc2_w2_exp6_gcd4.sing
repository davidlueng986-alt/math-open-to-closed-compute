// Wave 2 Explorer 6: DEGREE-135-IV-GCD-FOUR fast F_32003 structural & emptiness probe
// Keep N = u^5 + n3*u^3 + n2*u^2 + n1*u + n0 sparse (5 terms!) during division/ODE build (<0.5s!)
// All 10 constant-pivot linear eliminations (n0, a3..a0, t4..t0) are present as exact generators.

proc ucoeff(poly f, int k) {
  matrix C = coeffs(f, u);
  if (k + 1 > nrows(C)) { return(poly(0)); }
  return(C[k + 1, 1]);
}

proc udiv_q(poly F, poly D, int degF, int degD) {
  poly rem = F;
  poly q = 0;
  poly c;
  int k;
  for (k = degF; k >= degD; k--) {
    c = ucoeff(rem, k);
    if (c != 0) {
      q = q + c * u^(k - degD);
      rem = rem - c * u^(k - degD) * D;
    }
  }
  return(q);
}

ring Ru = 32003, (u, p0, t4, t3, t2, t1, t0, a4, a3, a2, a1, a0, w, v6, r3, r2, r1, r0, n3, n2, n1, n0), dp;

poly r = u^4 + r3*u^3 + r2*u^2 + r1*u + r0;
poly N = u^5 + n3*u^3 + n2*u^2 + n1*u + n0;

number b9 = number(9)/number(2);
poly b6 = number(9)/number(8) * (4*v6 - 13);
poly v3 = number(3)/number(500) * (500*v6 - 1001);
poly b3 = number(27)/number(500) * (377 - 125*v6);

// 1. B(u) and r | B'
poly N3 = N^3;
poly numB = b9*r^6 + b6*r^4*N + b3*r^2*N^2;
poly QB = udiv_q(numB, N3, 24, 15);
poly dQB = diff(QB, u);
poly g = udiv_q(dQB, r, 8, 4);
poly rem_r = dQB - g * r;

poly d3 = ucoeff(rem_r, 3);
poly d2 = ucoeff(rem_r, 2);
poly d1 = ucoeff(rem_r, 1);
poly d0 = ucoeff(rem_r, 0);

if (diff(d3, n0) != -54) { printf("ERROR: d3 n0 pivot mismatch!"); quit; }

poly c2 = -d1 / number(2);
poly c1 = -d0;
poly b2 = c2;
poly b1 = c1 - number(4)/number(3)*r3*b2;
poly v2 = number(2)/number(9)*b2;
poly v1 = number(2)/number(9)*b1;

printf("Stage 1 done: d3 terms=%s, d2 terms=%s, b2 terms=%s", size(d3), size(d2), size(b2));

// 2. Construct A(u) = r*V(u) of degree 13
poly numA = r^7 + v6*r^5*N + v3*r^3*N^2;
poly QA = udiv_q(numA, N3, 28, 15);
poly extraA = r * (v2*(u^2 + number(4)/number(3)*r3*u) + v1*u);
poly A = a4*u^4 + a3*u^3 + a2*u^2 + a1*u + a0;
int k;
for (k = 5; k <= 13; k++) {
  A = A + ucoeff(QA, k) * u^k;
}
for (k = 5; k <= 6; k++) {
  A = A + ucoeff(extraA, k) * u^k;
}
printf("Stage 2 done: A built!");

// 3. Solve ODE 2*M*T' - M'*T = 18*A*(A'*r - A*r') for T[22..5]
poly M = r^2 + N;
poly dM = diff(M, u);
list mcoeff;
for (k = 0; k <= 8; k++) { mcoeff[k+1] = ucoeff(M, k); }

poly RHS = 18 * A * (diff(A, u)*r - A*diff(r, u));
list tcoeff;
for (k = 1; k <= 23; k++) { tcoeff[k] = poly(0); }
int j, ii, d;
poly lhs_rest;
for (k = 22; k >= 5; k--) {
  d = k + 7;
  lhs_rest = 0;
  for (j = 0; j <= 7; j++) {
    ii = d + 1 - j;
    if (ii >= 5 && ii <= 22) {
      lhs_rest = lhs_rest + tcoeff[ii+1] * (2*ii - j) * mcoeff[j+1];
    }
  }
  tcoeff[k+1] = (ucoeff(RHS, d) - lhs_rest) / number(2*k - 8);
}
tcoeff[5] = t4;
tcoeff[4] = t3;
tcoeff[3] = t2;
tcoeff[2] = t1;
tcoeff[1] = t0;

poly Tfull = 0;
for (k = 0; k <= 22; k++) { Tfull = Tfull + tcoeff[k+1] * u^k; }

poly odeFull = 2*M*diff(Tfull, u) - dM*Tfull - RHS;
for (k = 12; k <= 29; k++) {
  if (ucoeff(odeFull, k) != 0) { printf("ERROR: odeFull nonzero at %s!", k); quit; }
}
printf("Stage 3 done: odeFull[12..29] == 0 verified!");

// 4. Compute pL = int(g*A) + p0 and sqFull = Tfull^2 - 9*pL*A^2 - M
poly gA = g * A;
poly pL = p0;
for (k = 0; k <= 17; k++) {
  pL = pL + ucoeff(gA, k) * u^(k+1) / number(k+1);
}
poly sqFull = Tfull^2 - 9*pL*A^2 - M;
for (k = 35; k <= 44; k++) {
  if (ucoeff(sqFull, k) != 0) { printf("ERROR: sqFull nonzero at %s!", k); quit; }
}
printf("Stage 4 done: sqFull[35..44] == 0 verified!");

// Verify exact constant pivots!
if (diff(ucoeff(sqFull, 34), a3) != number(-81)/number(16)) { printf("ERROR: a3 pivot!"); quit; }
if (diff(ucoeff(sqFull, 33), a2) != number(-81)/number(7)) { printf("ERROR: a2 pivot!"); quit; }
if (diff(ucoeff(sqFull, 32), a1) != number(-81)/number(4)) { printf("ERROR: a1 pivot!"); quit; }
if (diff(ucoeff(sqFull, 31), a0) != number(-162)/number(5)) { printf("ERROR: a0 pivot!"); quit; }
if (diff(ucoeff(sqFull, 26), t4) != 9) { printf("ERROR: t4 pivot!"); quit; }
printf("All exact constant pivots verified!");

// Build full ideal Iu (50 generators in 21 vars, sparse!)
ideal Iu = d3, d2, w*b2 - 1;
for (k = 11; k >= 0; k--) {
  Iu = Iu, ucoeff(odeFull, k);
}
for (k = 34; k >= 0; k--) {
  Iu = Iu, ucoeff(sqFull, k);
}
printf("Built sparse ideal Iu: size(Iu) = %s", size(Iu));

ring R21 = 32003, (p0, t4, t3, t2, t1, t0, a4, a3, a2, a1, a0, w, v6, r3, r2, r1, r0, n3, n2, n1, n0), dp;
ideal I21 = imap(Ru, Iu);

printf("=== Running slimgb(I21) over F_32003 ===");
option(prot);
ideal G21 = slimgb(I21);
printf("F_32003 slimgb(I21) size = %s, dim = %s, vdim = %s", size(G21), dim(G21), vdim(G21));
printf("G21[1] = %s", G21[1]);
quit;
