  "project": "Ramsey R(3,10) = 40 Closure Project",
  "repositories": {
    "compute": "https://github.com/davidlueng986-alt/math-open-to-closed-compute",
    "ledger": "https://github.com/davidlueng986-alt/math-open-to-closed"
  },
  "architecture_notes": [
    "D678 is logically structured as any_of(D678_V8_NA_COVER, D678_V7_COVER): both covers independently partition all 542 surviving D678 degree profiles (333 D6 + 209 D78) with zero coverage gaps.",
    "Legacy v7 closures (4 empty bands + 61/279 pure-integer Agent 1 tasks) are preserved immutably inside D678_V7_COVER and are NEVER mixed to skip any V8 Unified NA-DAG branch.",
    "All D5 double-encoding DRAT certificates, MIN6 arithmetic proofs, and D9-C7 4/4 DRAT certificates are preserved with full provenance and SHA-256 digests."
  ],
  "nodes": [
    {
      "id": "ROOT",
      "title": "Determine exact value of Ramsey number R(3,10)",
      "status": "OPEN",
      "any_of": ["YES", "NO"],
      "description": "Either a (3,10;40)-Ramsey graph exists (YES -> R(3,10)=41) or none exists (NO -> R(3,10)=40)."
    },
    {
      "id": "YES",
      "title": "Existence branch: R(3,10) = 41",
      "status": "OPEN",
      "all_of": ["B41", "W"],
      "description": "Requires upper bound R(3,10) <= 41 plus an independently verified 40-vertex triangle-free alpha <= 9 witness."
    },
    {
      "id": "B41",
      "title": "Upper bound R(3,10) <= 41",
      "status": "PROVED_MATH",
      "description": "Goedgebeur & Radziszowski (2013) proved R(3,10) <= 41 (improving Radziszowski & Kreher 1988, R(3,10) <= 42).",
      "provenance": {
        "dag_ref": "https://github.com/davidlueng986-alt/math-open-to-closed/commit/2bcbce99f8cc0882e3ecb89eeb3b24dbf0eb79c8"
      }
    },
    {
      "id": "W",
      "title": "40-vertex triangle-free alpha <= 9 witness",
      "status": "OPEN",
      "description": "Any SAT witness emitted by any solver job must pass zero-dependency verify_sat_witness.py."
    },
    {
      "id": "NO",
      "title": "Non-existence branch: R(3,10) = 40",
      "status": "OPEN",
      "all_of": [
        "B39",
        "SATURATE",
        "D10_PLUS",
        "D0_3",
        "D4",
        "D5_MIN6",
        "PROFILE_V6",
        "D678",
        "D9"
      ],
      "description": "Exhaustive partition of all possible 40-vertex triangle-free alpha <= 9 graphs by minimum/maximum vertex degrees."
    },
    {
      "id": "B39",
      "title": "Lower bound R(3,10) >= 40 via Exoo (3,10;39) witness",
      "status": "PROVED_MATH",
      "description": "Exoo (1989) constructed a 39-vertex triangle-free graph with alpha = 9 (exoo39.g6).",
      "provenance": {
        "commit": "https://github.com/davidlueng986-alt/math-open-to-closed-compute/commit/185260dbdf1c59352230cab01a9d31983ebc6b48"
      }
    },
    {
      "id": "SATURATE",
      "title": "Triangle-free edge saturation preserves alpha <= 9",
      "status": "PROVED_MATH",
      "description": "Adding edges without creating triangles can only decrease or preserve alpha(G); WLOG G is maximal triangle-free."
    },
    {
      "id": "D10_PLUS",
      "title": "Maximum degree Delta(G) <= 9",
      "status": "PROVED_MATH",
      "description": "In a triangle-free graph, N(v) is an independent set, so deg(v) >= 10 immediately yields I_10."
    },
    {
      "id": "D0_3",
      "title": "Minimum degree delta(G) >= 4",
      "status": "PROVED_MATH",
      "description": "If deg(v) <= 3, then |H_v| = 39 - deg(v) >= 36 = R(3,9), forcing I_9 in H_v and hence I_10 with v."
    },
    {
      "id": "D4",
      "title": "No vertex of degree 4",
      "status": "PROVED_MATH",
      "description": "If deg(v) = 4, H_v is a (3,9;35)-graph (unique Kalbfleisch graph); Goedgebeur & Radziszowski (2013) proved no 40-vertex extension exists."
    },
    {
      "id": "D5_MIN6",
      "title": "No vertex of degree 5 (Double-encoding DRAT + Direct MIN6 arithmetic proof)",
      "status": "CERTIFIED_DRAT",
      "all_of": ["D5-N5", "D5-N6", "D5-N7", "D5-N8", "D5-N9", "MIN6-DIRECT"],
      "description": "Closes all degree-5 cases via both independent double-encoding DRAT proofs (D5-N5..N9) and the direct MIN6 singleton-capacity theorem (43 > 40)."
    },
    {
      "id": "MIN6-DIRECT",
      "title": "Direct MIN6 theorem: delta(G) >= 6",
      "status": "PROVED_MATH",
      "description": "For a degree-5 vertex v, e(N(v), H_v) >= 2(34) - 5(5) = 43 > 40 = 8*5, contradiction; independently closes D5, D6-N5, D7-N5, D8-N5.",
      "provenance": {
