// Pure-Singular EXACT Q-PROOF for DEGREE-135-IV-GCD-SIX!
// Weighted-homogeneous subsystem (l = 1 WLOG since l != 0):
//   - 2*M*T' - M'*T = 18*A*(A'*r - A*r')  (degrees 23..5; t20..t3 solved uniquely with integer denoms)
//   - coeff_d(T^2 - 9*p_L*A^2) = 0        (degrees 30..23; degrees 40..31 vanish identically!)
//   - w * b2 - 1 = 0                      (b2 != 0 from ord_w Delta D = 10)
// Eliminates a1 from eq30 (const coeff -81/16) and a0 from eq29 (const coeff -648/7) -> ONLY 5 vars!
// Proves 1 in I_top over Q via BOTH exact modStd(I, 1) AND direct groebner/slimgb over Q!

LIB "modstd.lib";

proc ucoeff(poly f, int k) {
  if (f == 0) { return(poly(0)); }
  matrix C = coeffs(f, u);
  if (k + 1 > nrows(C)) { return(poly(0)); }
  return(C[k + 1, 1]);
}

ring Ru = 0, (u, a2, a1, a0, w, v6, r0, r1), dp;

poly r = u^2 + r1*u + r0;
number b9 = 9/2;
poly b6 = 9/8*(4*v6 - 13);
poly v3 = 3/500*(500*v6 - 1001);
poly b3 = 27/500*(377 - 125*v6);

// 1. Construct B(u) with b8=b7=b5=b4=0 and r | B'
poly numB = b9*r^6 + b6*u*r^4 + b3*u^2*r^2;
poly polyB = 0;
int k;
for (k = 3; k <= 12; k++) {
  polyB = polyB + ucoeff(numB, k) * u^(k - 3);
}
poly dpolyB = diff(polyB, u);
poly remB = reduce(dpolyB, std(r));
poly c2 = -ucoeff(remB, 1) / 2;
poly c1 = -ucoeff(remB, 0);
poly B = polyB + c2*u^2 + c1*u;
poly dB = diff(B, u);
poly g = dB / r;
if (g * r != dB) { printf("ERROR: r does not divide B'!"); quit; }

poly b2 = c2;
poly b1 = c1 - 4/3*r1*b2;
poly v2 = 2/9*b2;
poly v1 = 2/9*b1;

// 2. Construct A(u) = r*V(u)
poly numA = r^7 + v6*u*r^5 + v3*u^2*r^3;
poly polyA = 0;
for (k = 6; k <= 14; k++) {
  polyA = polyA + ucoeff(numA, k) * u^(k - 3);
}
poly extraA = r * (v2*(u^2 + 4/3*r1*u) + v1*u);
for (k = 3; k <= 4; k++) {
  polyA = polyA + ucoeff(extraA, k) * u^k;
}
poly A = polyA + a2*u^2 + a1*u + a0;

// 3. Exact ODE 2*M*T' - M'*T = 18*A*(A'*r - A*r') for t[20]..t[3] and ode5
poly M = r^2 + u;
poly dM = diff(M, u);
poly RHS = 18 * A * (diff(A, u)*r - A*diff(r, u));

list tcoeff;
for (k = 1; k <= 21; k++) { tcoeff[k] = poly(0); }
list mcoeff;
int j, ii, d;
for (j = 0; j <= 4; j++) { mcoeff[j+1] = ucoeff(M, j); }

poly lhs_rest;
for (k = 20; k >= 3; k--) {
  d = k + 3;
  lhs_rest = 0;
  for (j = 0; j <= 3; j++) {
    ii = d + 1 - j;
    if (ii >= 3 && ii <= 20) {
      lhs_rest = lhs_rest + tcoeff[ii+1] * (2*ii - j) * mcoeff[j+1];
    }
  }
  tcoeff[k+1] = (ucoeff(RHS, d) - lhs_rest) / (2*k - 4);
}

poly Thi = 0;
for (k = 3; k <= 20; k++) { Thi = Thi + tcoeff[k+1] * u^k; }
poly odeDiff = 2*M*diff(Thi, u) - dM*Thi - RHS;

for (k = 6; k <= 23; k++) {
  if (ucoeff(odeDiff, k) != 0) { printf("ERROR: odeDiff nonzero at %s!", k); quit; }
}
poly ode5 = ucoeff(odeDiff, 5);

// 4. Compute pL = int(g*A) and sqDiff = Thi^2 - 9*pL*A^2
poly gA = g * A;
poly pL = 0;
for (k = 0; k <= 17; k++) {
  pL = pL + ucoeff(gA, k) * u^(k+1) / (k+1);
}
poly sqDiff = Thi^2 - 9*pL*A^2;
for (k = 31; k <= 40; k++) {
  if (ucoeff(sqDiff, k) != 0) { printf("ERROR: sqDiff nonzero at %s!", k); quit; }
}

poly eq30 = ucoeff(sqDiff, 30);
poly eq29 = ucoeff(sqDiff, 29);
poly eq28 = ucoeff(sqDiff, 28);
poly eq27 = ucoeff(sqDiff, 27);
poly eq26 = ucoeff(sqDiff, 26);
poly eq25 = ucoeff(sqDiff, 25);
poly eq24 = ucoeff(sqDiff, 24);
poly eq23 = ucoeff(sqDiff, 23);

// Eliminate a1 from eq30 (coeff -81/16) and a0 from eq29 (coeff -648/7) — exact rational substitution!
if (diff(eq30, a1) != -81/16) { printf("ERROR: eq30 a1 coeff mismatch!"); quit; }
poly a1_sol = subst(eq30, a1, 0) * (16/81);
poly eq29_s = subst(eq29, a1, a1_sol);
if (diff(eq29_s, a0) != -648/7) { printf("ERROR: eq29 a0 coeff mismatch!"); quit; }
poly a0_sol = subst(eq29_s, a0, 0) * (7/648);

poly f28 = subst(subst(eq28, a1, a1_sol), a0, a0_sol);
poly f27 = subst(subst(eq27, a1, a1_sol), a0, a0_sol);
poly f26 = subst(subst(eq26, a1, a1_sol), a0, a0_sol);
poly f25 = subst(subst(eq25, a1, a1_sol), a0, a0_sol);
poly f24 = subst(subst(eq24, a1, a1_sol), a0, a0_sol);
poly f23 = subst(subst(eq23, a1, a1_sol), a0, a0_sol);
poly f5  = subst(subst(ode5, a1, a1_sol), a0, a0_sol);

// Check that f28..f23, f5 are ALL linear in a2 and free of u, a1, a0!
ideal Ired_u = f28, f27, f26, f25, f24, f23, f5, w*b2 - 1;
printf("Reduced to 5 variables (a2, w, v6, r0, r1)! size(Ired_u)=%s", size(Ired_u));

ring R5 = 0, (a2, w, v6, r0, r1), dp;
ideal I5 = imap(Ru, Ired_u);

// Check F_32003 first:
ring R5p = 32003, (a2, w, v6, r0, r1), dp;
ideal I5p = imap(R5, I5);
ideal G5p = slimgb(I5p);
printf("F_32003 slimgb(I5) size = %s, G5p[1] = %s", size(G5p), G5p[1]);

// EXACT Q PROOF 1: modStd(I5, 1) (exactness=1 performs full Q verification!)
setring R5;
printf("=== Running EXACT Q-verified modStd(I5, 1) in 5 vars ===");
ideal G5q = modStd(I5, 1);
printf("Q modStd(I5, 1) size = %s, G5q[1] = %s", size(G5q), G5q[1]);
if (size(G5q) == 1 && G5q[1] == 1) {
  printf("CERTIFIED_MODSTD_Q: DEGREE_135_IV_GCD_SIX_PROVED_EMPTY_OVER_Q");
}

// EXACT Q PROOF 2: Direct deterministic slimgb(I5) over Q (zero modular lifting!)
printf("=== Running DIRECT deterministic slimgb(I5) over Q ===");
ideal G5direct = slimgb(I5);
printf("Q direct slimgb(I5) size = %s, G5direct[1] = %s", size(G5direct), G5direct[1]);
if (size(G5direct) == 1 && G5direct[1] == 1) {
  printf("CERTIFIED_DIRECT_Q: DEGREE_135_IV_GCD_SIX_PROVED_EMPTY_OVER_Q");
}
quit;
