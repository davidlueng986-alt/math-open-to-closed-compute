// Pure-Singular exact Q-proof for DEGREE-135-IV-GCD-SIX!
// Zero SymPy overhead: builds all polynomials in C++ in <0.1s!
// Weighted-homogeneous subsystem (l = 1 WLOG since l != 0):
//   - 2*M*T' - M'*T = 18*A*(A'*r - A*r')  (all degrees 23..0)
//   - coeff_d(T^2 - 9*p_L*A^2) = 0        (degrees 26..5)
//   - w * b2 - 1 = 0                      (b2 != 0 from ord_w Delta D = 10)
// Runs F_32003 check first, then exact Q modStd(I, 1) (with exact Q verification).

LIB "modstd.lib";

proc ucoeff(poly f, int k) {
  if (f == 0) { return(poly(0)); }
  matrix C = coeffs(f, u);
  if (k + 1 > nrows(C)) { return(poly(0)); }
  return(C[k + 1, 1]);
}

ring Ru = 0, (u, p0, t2, t1, t0, a2, a1, a0, w, v6, r0, r1), dp;

poly r = u^2 + r1*u + r0;
number b9 = 9/2;
poly b6 = 9/8*(4*v6 - 13);
poly v3 = 3/500*(500*v6 - 1001);
poly b3 = 27/500*(377 - 125*v6);

// 1. Construct B(u) with b8=b7=b5=b4=0 and r | B'
poly numB = b9*r^6 + b6*u*r^4 + b3*u^2*r^2;
poly polyB = 0;
int k;
for (k = 3; k <= 12; k++) {
  polyB = polyB + ucoeff(numB, k) * u^(k - 3);
}
poly dpolyB = diff(polyB, u);
poly remB = reduce(dpolyB, std(r));
poly c2 = -ucoeff(remB, 1) / 2;
poly c1 = -ucoeff(remB, 0);
poly B = polyB + c2*u^2 + c1*u;
poly dB = diff(B, u);
poly g = dB / r;
if (g * r != dB) { printf("ERROR: r does not divide B'!"); quit; }

poly b2 = c2;
poly b1 = c1 - 4/3*r1*b2;
poly v2 = 2/9*b2;
poly v1 = 2/9*b1;

// 2. Construct A(u) = r*V(u)
poly numA = r^7 + v6*u*r^5 + v3*u^2*r^3;
poly polyA = 0;
for (k = 6; k <= 14; k++) {
  polyA = polyA + ucoeff(numA, k) * u^(k - 3);
}
poly extraA = r * (v2*(u^2 + 4/3*r1*u) + v1*u);
for (k = 3; k <= 4; k++) {
  polyA = polyA + ucoeff(extraA, k) * u^k;
}
poly A = polyA + a2*u^2 + a1*u + a0;

// 3. Exact ODE 2*M*T' - M'*T = 18*A*(A'*r - A*r')
poly M = r^2 + u;
poly dM = diff(M, u);
poly RHS = 18 * A * (diff(A, u)*r - A*diff(r, u));

list tcoeff;
for (k = 1; k <= 21; k++) { tcoeff[k] = poly(0); }
list mcoeff;
int j, ii, d;
for (j = 0; j <= 4; j++) { mcoeff[j+1] = ucoeff(M, j); }

for (k = 20; k >= 3; k--) {
  d = k + 3;
  poly lhs_rest = 0;
  for (j = 0; j <= 3; j++) {
    ii = d + 1 - j;
    if (ii >= 3 && ii <= 20) {
      lhs_rest = lhs_rest + tcoeff[ii+1] * (2*ii - j) * mcoeff[j+1];
    }
  }
  tcoeff[k+1] = (ucoeff(RHS, d) - lhs_rest) / (2*k - 4);
}
tcoeff[3] = t2;
tcoeff[2] = t1;
tcoeff[1] = t0;

poly Tfull = 0;
for (k = 0; k <= 20; k++) { Tfull = Tfull + tcoeff[k+1] * u^k; }
poly odeDiff = 2*M*diff(Tfull, u) - dM*Tfull - RHS;

for (k = 6; k <= 23; k++) {
  if (ucoeff(odeDiff, k) != 0) { printf("ERROR: odeDiff nonzero at %s!", k); quit; }
}
poly ode5 = ucoeff(odeDiff, 5);
poly ode4 = ucoeff(odeDiff, 4);
poly ode3 = ucoeff(odeDiff, 3);
poly ode2 = ucoeff(odeDiff, 2);
poly ode1 = ucoeff(odeDiff, 1);
poly ode0 = ucoeff(odeDiff, 0);

// 4. Compute pL = int(g*A) + p0 and sqDiff = Tfull^2 - 9*pL*A^2
poly gA = g * A;
poly pL = p0;
for (k = 0; k <= 17; k++) {
  pL = pL + ucoeff(gA, k) * u^(k+1) / (k+1);
}
poly sqDiff = Tfull^2 - 9*pL*A^2;
for (k = 27; k <= 40; k++) {
  if (ucoeff(sqDiff, k) != 0) { printf("ERROR: sqDiff nonzero at %s!", k); quit; }
}

ideal Iu = ode5, ode4, ode3, ode2, ode1, ode0, w*b2 - 1;
for (k = 5; k <= 26; k++) {
  Iu = Iu, ucoeff(sqDiff, k);
}
printf("All 29 exact polynomials built in Singular! size(Iu)=%s", size(Iu));

// Map to ring without u!
ring Rq = 0, (p0, t2, t1, t0, a2, a1, a0, w, v6, r0, r1), dp;
ideal Iall = imap(Ru, Iu);

// First test over F_32003
ring Rp = 32003, (p0, t2, t1, t0, a2, a1, a0, w, v6, r0, r1), dp;
ideal Ip = imap(Rq, Iall);
printf("=== Running slimgb(Ip) over F_32003 ===");
ideal Gp = slimgb(Ip);
printf("F_32003 slimgb(Iall) size = %s, Gp[1] = %s", size(Gp), Gp[1]);

// Now exact Q proof via modStd(Iall, 1) (with exact Q verification)!
setring Rq;
printf("=== Running exact modStd(Iall, 1) over Q ===");
ideal Gq = modStd(Iall, 1);
printf("Q modStd(Iall, 1) size = %s, Gq[1] = %s", size(Gq), Gq[1]);
if (size(Gq) == 1 && Gq[1] == 1) {
  printf("SUCCESS: DEGREE_135_IV_GCD_SIX_PROVED_EMPTY_OVER_Q");
}
quit;
