// Pure-Singular probe & exact Q-proof for DEGREE-135-IV-GCD-FOUR!
// Universal Differential-Norm Identity:
//   2*M*T' - M'*T = 18*A*(A'*r - A*r')
//   T^2 - 9*pL*A^2 = M = r^2 + N
//   B' = g*r, pL' = g*A, deg(g)=4, deg(r)=4, deg(N)=5, deg(A)=13, deg(T)=22
// Translation gauge: n4 = 2*r3 => z = (r^2/N)^(1/3) = u + O(u^-1)
// Keep n0, a3..a0, t3..t0, p0 unexpanded where sparse, or eliminate cleanly with constant pivots.
// Actually: keep n0 as a variable (eq_rB3 is linear in n0 with const pivot -54 -> instant elimination in slimgb!)
// and keep a4..a0, t4..t0, p0 eliminated ONLY via exact constant pivots (or kept if sparse)!

LIB "modstd.lib";
option(prot);

proc ucoeff(poly f, int k) {
  if (f == 0) { return(poly(0)); }
  matrix C = coeffs(f, u);
  if (nrows(C) <= k) { return(poly(0)); }
  return(C[k + 1, 1]);
}

proc udeg(poly f) {
  if (f == 0) { return(-1); }
  matrix C = coeffs(f, u);
  return(nrows(C) - 1);
}

// Exact polynomial quotient of P by MONIC Q of degree dQ in u (stopping at minK >= 0)
proc polyQuoMonic(poly P, poly Q, int dQ, int minK) {
  poly rem = P;
  poly q = 0;
  poly c = 0;
  int dP = udeg(rem);
  int k;
  for (k = dP; k >= dQ + minK; k--) {
    c = ucoeff(rem, k);
    if (c != 0) {
      q = q + c * u^(k - dQ);
      rem = rem - c * u^(k - dQ) * Q;
    }
  }
  return(q);
}

ring Ru = 0, (u, p0, t4, t3, t2, t1, t0, a4, a3, a2, a1, a0, w, v6, r3, r2, r1, r0, n3, n2, n1, n0), dp;

poly r = u^4 + r3*u^3 + r2*u^2 + r1*u + r0;
poly N = u^5 + 2*r3*u^4 + n3*u^3 + n2*u^2 + n1*u + n0;

number b9 = number(9)/number(2);
poly b6 = (number(9)/number(8))*(4*v6 - 13);
poly v3 = (number(3)/number(500))*(500*v6 - 1001);
poly b3 = (number(27)/number(500))*(377 - 125*v6);

// 1. Construct polyB, g, eq_rB3, eq_rB2, b2, b1 (keeping n0 as a sparse variable!)
poly N3 = N^3;
poly numB = b9*r^6 + b6*N*r^4 + b3*N^2*r^2;
poly polyB = polyQuoMonic(numB, N3, 15, 0);
poly dpolyB = diff(polyB, u);
poly g = polyQuoMonic(dpolyB, r, 4, 0);
poly remB = dpolyB - g*r;
poly eq_rB3 = ucoeff(remB, 3);
poly eq_rB2 = ucoeff(remB, 2);
poly c2 = -ucoeff(remB, 1) / number(2);
poly c1 = -ucoeff(remB, 0);
poly b2 = c2;
poly b1 = c1;
poly v2 = (number(2)/number(9))*b2;
poly v1 = (number(2)/number(9))*b1;
printf("Step 1 done: deg(g)=%s, size(eq_rB3)=%s, size(eq_rB2)=%s, size(b2)=%s",
       udeg(g), size(eq_rB3), size(eq_rB2), size(b2));

// 2. Construct A(u) (only need deg >= 5 of polyA!)
poly numA = r^7 + v6*N*r^5 + v3*N^2*r^3;
poly polyA = polyQuoMonic(numA, N3, 15, 5);
poly extraA = r * (v2*u^2 + v1*u);
poly A_hi = 0;
int k;
for (k = 5; k <= 13; k++) {
  A_hi = A_hi + (ucoeff(polyA, k) + ucoeff(extraA, k)) * u^k;
}
poly A = A_hi + a4*u^4 + a3*u^3 + a2*u^2 + a1*u + a0;
printf("Step 2 done: deg(A)=%s, size(A)=%s", udeg(A), size(A));

// 3. Exact ODE 2*M*T' - M'*T = 18*A*(A'*r - A*r') for t[22]..t[5]
poly M = r^2 + N;
poly dM = diff(M, u);
poly RHS = 18 * A * (diff(A, u)*r - A*diff(r, u));

matrix tcoeff[23][1];
matrix mcoeff[9][1];
int j, ii, d;
for (j = 0; j <= 8; j++) { mcoeff[j+1, 1] = ucoeff(M, j); }
matrix rhscoeff = coeffs(RHS, u);

for (k = 22; k >= 5; k--) {
  d = k + 7;
  poly lhs_rest = 0;
  for (j = 0; j <= 7; j++) {
    ii = d + 1 - j;
    if (ii >= 5 && ii <= 22) {
      lhs_rest = lhs_rest + tcoeff[ii+1, 1] * number(2*ii - j) * mcoeff[j+1, 1];
    }
  }
  poly rhs_d = 0;
  if (nrows(rhscoeff) > d) { rhs_d = rhscoeff[d+1, 1]; }
  tcoeff[k+1, 1] = (rhs_d - lhs_rest) / number(2*k - 8);
}
tcoeff[5, 1] = t4;
tcoeff[4, 1] = t3;
tcoeff[3, 1] = t2;
tcoeff[2, 1] = t1;
tcoeff[1, 1] = t0;

poly Tfull = 0;
for (k = 0; k <= 22; k++) { Tfull = Tfull + tcoeff[k+1, 1] * u^k; }
poly odeDiff = 2*M*diff(Tfull, u) - dM*Tfull - RHS;
matrix odeC = coeffs(odeDiff, u);
for (k = 12; k <= 29; k++) {
  if (nrows(odeC) > k && odeC[k+1, 1] != 0) {
    printf("ERROR: odeDiff nonzero at %s!", k);
    quit;
  }
}
printf("Step 3 done: odeDiff[12..29] identically 0!");

// 4. Compute pL = int(g*A) + p0 and sqFull = Tfull^2 - 9*pL*A^2 - M
poly gA = g * A;
matrix gAC = coeffs(gA, u);
poly pL = p0;
for (k = 0; k <= 17; k++) {
  if (nrows(gAC) > k) {
    pL = pL + gAC[k+1, 1] * u^(k+1) / number(k+1);
  }
}
poly sqFull = Tfull^2 - 9*pL*A^2 - M;
matrix sqC = coeffs(sqFull, u);
printf("Step 4 done: sqFull built!");

// Verify universal constant pivots!
if (diff(sqC[35, 1], a3) != number(-81)/number(16)) { printf("ERROR: sq34 a3 pivot = %s", diff(sqC[35, 1], a3)); quit; }
if (diff(odeC[11, 1], t3) != number(-2)) { printf("ERROR: ode10 t3 pivot = %s", diff(odeC[11, 1], t3)); quit; }
if (diff(sqC[27, 1], p0) != number(-9)) { printf("ERROR: sq26 p0 pivot = %s", diff(sqC[27, 1], p0)); quit; }
printf("Verified exact constant pivots! Printing generator sizes:");
printf("  ode11..0: %s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s",
  size(odeC[12,1]),size(odeC[11,1]),size(odeC[10,1]),size(odeC[9,1]),size(odeC[8,1]),size(odeC[7,1]),
  size(odeC[6,1]),size(odeC[5,1]),size(odeC[4,1]),size(odeC[3,1]),size(odeC[2,1]),size(odeC[1,1]));
printf("  sq34..23: %s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s",
  size(sqC[35,1]),size(sqC[34,1]),size(sqC[33,1]),size(sqC[32,1]),size(sqC[31,1]),size(sqC[30,1]),
  size(sqC[29,1]),size(sqC[28,1]),size(sqC[27,1]),size(sqC[26,1]),size(sqC[25,1]),size(sqC[24,1]));

// Build sparse ideal (NO dense substitutions! Let slimgb use linear pivots cleanly!)
ideal I_u = eq_rB3, eq_rB2, w*b2 - 1;
for (k = 0; k <= 11; k++) { I_u = I_u, odeC[k+1, 1]; }
for (k = 23; k <= 34; k++) { I_u = I_u, sqC[k+1, 1]; }

ring R21 = 0, (p0, t4, t3, t2, t1, t0, a4, a3, a2, a1, a0, w, v6, r3, r2, r1, r0, n3, n2, n1, n0), dp;
ideal I21 = imap(Ru, I_u);

ring R21p = 32003, (p0, t4, t3, t2, t1, t0, a4, a3, a2, a1, a0, w, v6, r3, r2, r1, r0, n3, n2, n1, n0), dp;
ideal I21p = imap(R21, I21);
printf("=== Running slimgb(I21p) over F_32003 (27 sparse eqs in 21 vars; 11 linear pivots!) ===");
ideal G21p = slimgb(I21p);
printf("F_32003 slimgb(I21p): size = %s, G[1] = %s, dim = %s, vdim = %s",
       size(G21p), G21p[1], dim(G21p), vdim(G21p));

if (size(G21p) == 1 && G21p[1] == 1) {
  printf("UNIT_IDEAL_MOD_32003! Now launching exact Q modStd(I21, 1)...");
  setring R21;
  ideal G21q = modStd(I21, 1);
  printf("Q modStd(I21, 1): size = %s, G[1] = %s", size(G21q), G21q[1]);
  if (size(G21q) == 1 && G21q[1] == 1) {
    printf("CERTIFIED_MODSTD_Q: DEGREE_135_IV_GCD_FOUR_PROVED_EMPTY_OVER_Q");
  }
}
quit;
