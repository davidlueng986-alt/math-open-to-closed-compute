// Pure-Singular 10-var/11-var probe & exact Q-proof for DEGREE-135-IV-GCD-FOUR!
// Key speedup: build ALL polynomials with n0, a3..a0, t3..t0, p0 unexpanded (<0.5s!),
// THEN eliminate n0, a3..a0, t3..t0, p0 (10 universal constant pivots!) ONLY on the scalar equations!
// Plus use natural weighted degrevlex ordering wp(...)!

LIB "modstd.lib";
option(prot);

proc ucoeff(poly f, int k) {
  if (f == 0) { return(poly(0)); }
  matrix C = coeffs(f, u);
  if (nrows(C) <= k) { return(poly(0)); }
  return(C[k + 1, 1]);
}

proc udeg(poly f) {
  if (f == 0) { return(-1); }
  matrix C = coeffs(f, u);
  return(nrows(C) - 1);
}

proc polyQuoMonic(poly P, poly Q, int dQ, int minK) {
  poly rem = P;
  poly q = 0;
  poly c = 0;
  int dP = udeg(rem);
  int k;
  for (k = dP; k >= dQ + minK; k--) {
    c = ucoeff(rem, k);
    if (c != 0) {
      q = q + c * u^(k - dQ);
      rem = rem - c * u^(k - dQ) * Q;
    }
  }
  return(q);
}

ring Ru = 0, (u, p0, t4, t3, t2, t1, t0, a4, a3, a2, a1, a0, w, v6, r3, r2, r1, r0, n3, n2, n1, n0), dp;

poly r = u^4 + r3*u^3 + r2*u^2 + r1*u + r0;
poly N = u^5 + 2*r3*u^4 + n3*u^3 + n2*u^2 + n1*u + n0;

number b9 = number(9)/number(2);
poly b6 = (number(9)/number(8))*(4*v6 - 13);
poly v3 = (number(3)/number(500))*(500*v6 - 1001);
poly b3 = (number(27)/number(500))*(377 - 125*v6);

// 1. Construct polyB, g, eq_rB3, eq_rB2, b2, b1 (sparse, n0 unexpanded!)
poly N3 = N^3;
poly numB = b9*r^6 + b6*N*r^4 + b3*N^2*r^2;
poly polyB = polyQuoMonic(numB, N3, 15, 0);
poly dpolyB = diff(polyB, u);
poly g = polyQuoMonic(dpolyB, r, 4, 0);
poly remB = dpolyB - g*r;
poly eq_rB3 = ucoeff(remB, 3);
poly eq_rB2 = ucoeff(remB, 2);
poly c2 = -ucoeff(remB, 1) / number(2);
poly c1 = -ucoeff(remB, 0);
poly b2 = c2;
poly b1 = c1;
poly v2 = (number(2)/number(9))*b2;
poly v1 = (number(2)/number(9))*b1;
if (diff(eq_rB3, n0) != number(-54)) { printf("ERROR: n0 pivot!"); quit; }
poly n0_sol = subst(eq_rB3, n0, 0) / number(54);
printf("Step 1 done: size(n0_sol)=%s", size(n0_sol));

// 2. Construct A(u)
poly numA = r^7 + v6*N*r^5 + v3*N^2*r^3;
poly polyA = polyQuoMonic(numA, N3, 15, 5);
poly extraA = r * (v2*u^2 + v1*u);
poly A_hi = 0;
int k;
for (k = 5; k <= 13; k++) {
  A_hi = A_hi + (ucoeff(polyA, k) + ucoeff(extraA, k)) * u^k;
}
poly A = A_hi + a4*u^4 + a3*u^3 + a2*u^2 + a1*u + a0;

// 3. Exact ODE 2*M*T' - M'*T = 18*A*(A'*r - A*r')
poly M = r^2 + N;
poly dM = diff(M, u);
poly RHS = 18 * A * (diff(A, u)*r - A*diff(r, u));

matrix tcoeff[23][1];
matrix mcoeff[9][1];
int j, ii, d;
for (j = 0; j <= 8; j++) { mcoeff[j+1, 1] = ucoeff(M, j); }
matrix rhscoeff = coeffs(RHS, u);

for (k = 22; k >= 5; k--) {
  d = k + 7;
  poly lhs_rest = 0;
  for (j = 0; j <= 7; j++) {
    ii = d + 1 - j;
    if (ii >= 5 && ii <= 22) {
      lhs_rest = lhs_rest + tcoeff[ii+1, 1] * number(2*ii - j) * mcoeff[j+1, 1];
    }
  }
  poly rhs_d = 0;
  if (nrows(rhscoeff) > d) { rhs_d = rhscoeff[d+1, 1]; }
  tcoeff[k+1, 1] = (rhs_d - lhs_rest) / number(2*k - 8);
}
tcoeff[5, 1] = t4;
tcoeff[4, 1] = t3;
tcoeff[3, 1] = t2;
tcoeff[2, 1] = t1;
tcoeff[1, 1] = t0;

poly Tfull = 0;
for (k = 0; k <= 22; k++) { Tfull = Tfull + tcoeff[k+1, 1] * u^k; }
poly odeDiff = 2*M*diff(Tfull, u) - dM*Tfull - RHS;
matrix odeC = coeffs(odeDiff, u);

// 4. Compute pL = int(g*A) + p0 and sqFull = Tfull^2 - 9*pL*A^2 - M
poly gA = g * A;
matrix gAC = coeffs(gA, u);
poly pL = p0;
for (k = 0; k <= 17; k++) {
  if (nrows(gAC) > k) {
    pL = pL + gAC[k+1, 1] * u^(k+1) / number(k+1);
  }
}
poly sqFull = Tfull^2 - 9*pL*A^2 - M;
matrix sqC = coeffs(sqFull, u);
printf("Steps 2-4 done!");

// 5. Scalar elimination of a3..a0, t3..t0, p0 (still keeping n0 as a variable? No, substitute n0 AFTER or BEFORE!)
// First eliminate a3..a0 from sq34..sq31!
poly sq34 = sqC[35, 1];
if (diff(sq34, a3) != number(-81)/number(16)) { printf("ERROR: a3 pivot!"); quit; }
poly a3_s = subst(sq34, a3, 0) * (number(16)/number(81));

poly sq33 = subst(sqC[34, 1], a3, a3_s);
if (diff(sq33, a2) != number(-81)/number(7)) { printf("ERROR: a2 pivot!"); quit; }
poly a2_s = subst(sq33, a2, 0) * (number(7)/number(81));

poly sq32 = subst(subst(sqC[33, 1], a3, a3_s), a2, a2_s);
if (diff(sq32, a1) != number(-81)/number(4)) { printf("ERROR: a1 pivot!"); quit; }
poly a1_s = subst(sq32, a1, 0) * (number(4)/number(81));

poly sq31 = subst(subst(subst(sqC[32, 1], a3, a3_s), a2, a2_s), a1, a1_s);
if (diff(sq31, a0) != number(-162)/number(5)) { printf("ERROR: a0 pivot!"); quit; }
poly a0_s = subst(sq31, a0, 0) * (number(5)/number(162));

// Eliminate t3..t0 from ode10..ode7!
poly o10 = odeC[11, 1];
if (diff(o10, t3) != number(-2)) { printf("ERROR: t3 pivot!"); quit; }
poly t3_s = subst(o10, t3, 0) / number(2);

poly o9 = subst(odeC[10, 1], t3, t3_s);
if (diff(o9, t2) != number(-4)) { printf("ERROR: t2 pivot!"); quit; }
poly t2_s = subst(o9, t2, 0) / number(4);

poly o8 = subst(subst(odeC[9, 1], t3, t3_s), t2, t2_s);
if (diff(o8, t1) != number(-6)) { printf("ERROR: t1 pivot!"); quit; }
poly t1_s = subst(o8, t1, 0) / number(6);

poly o7 = subst(subst(subst(odeC[8, 1], t3, t3_s), t2, t2_s), t1, t1_s);
if (diff(o7, t0) != number(-8)) { printf("ERROR: t0 pivot!"); quit; }
poly t0_s = subst(o7, t0, 0) / number(8);

// Eliminate p0 from sq26!
poly s26 = sqC[27, 1];
if (diff(s26, p0) != number(-9)) { printf("ERROR: p0 pivot!"); quit; }
poly p0_s = subst(s26, p0, 0) / number(9);

printf("All 9 scalar pivots (a3..a0, t3..t0, p0) verified! Substituting into scalar equations...");

// Helper: substitute a3..a0, t3..t0, p0 (keeping n0 sparse!)
proc elim9(poly f) {
  poly res = subst(f, p0, p0_s);
  res = subst(res, t0, t0_s);
  res = subst(res, t1, t1_s);
  res = subst(res, t2, t2_s);
  res = subst(res, t3, t3_s);
  res = subst(res, a0, a0_s);
  res = subst(res, a1, a1_s);
  res = subst(res, a2, a2_s);
  res = subst(res, a3, a3_s);
  return(res);
}

poly f30 = elim9(sqC[31, 1]);
poly f29 = elim9(sqC[30, 1]);
poly f28 = elim9(sqC[29, 1]);
poly f27 = elim9(sqC[28, 1]);
poly f25 = elim9(sqC[26, 1]);
poly f24 = elim9(sqC[25, 1]);
poly f23 = elim9(sqC[24, 1]);
poly e11 = elim9(odeC[12, 1]);
poly e6  = elim9(odeC[7, 1]);
poly e5  = elim9(odeC[6, 1]);
poly e4  = elim9(odeC[5, 1]);
poly e3  = elim9(odeC[4, 1]);
poly e2  = elim9(odeC[3, 1]);
poly e1  = elim9(odeC[2, 1]);
poly e0  = elim9(odeC[1, 1]);

printf("Reduced to 12 vars (t4,a4,w,v6,r3,r2,r1,r0,n3,n2,n1,n0)! Sizes:");
printf("  f30..f27: %s, %s, %s, %s", size(f30), size(f29), size(f28), size(f27));
printf("  f25,f24,f23: %s, %s, %s", size(f25), size(f24), size(f23));
printf("  e11,e6..e0: %s, %s,%s,%s,%s,%s,%s,%s", size(e11), size(e6), size(e5), size(e4), size(e3), size(e2), size(e1), size(e0));

ideal I12_u = eq_rB3, eq_rB2, w*b2 - 1, f30, f29, f28, f27, f25, f24, f23, e11, e6, e5, e4, e3, e2, e1, e0;

// Map to 12-var ring with weighted degrevlex!
ring R12 = 0, (t4, a4, w, v6, r3, r2, r1, r0, n3, n2, n1, n0), wp(18, 9, 1, 3, 1, 2, 3, 4, 2, 3, 4, 5);
ideal I12 = imap(Ru, I12_u);

ring R12p = 32003, (t4, a4, w, v6, r3, r2, r1, r0, n3, n2, n1, n0), wp(18, 9, 1, 3, 1, 2, 3, 4, 2, 3, 4, 5);
ideal I12p = imap(R12, I12);

// Fast diagnostic 1: 2-slice (r3=0, r2=1) over F_32003!
printf("=== Diagnostic 1: 2-slice (r3=0, r2=1) over F_32003 ===");
ideal I_sl2 = I12p, r3, r2 - 1;
ideal G_sl2 = slimgb(I_sl2);
printf("2-slice (r3=0,r2=1): size=%s, G[1]=%s, dim=%s", size(G_sl2), G_sl2[1], dim(G_sl2));

// Fast diagnostic 2: 1-slice (r3=0) over F_32003!
printf("=== Diagnostic 2: 1-slice (r3=0) over F_32003 ===");
ideal I_sl1 = I12p, r3;
ideal G_sl1 = slimgb(I_sl1);
printf("1-slice (r3=0): size=%s, G[1]=%s, dim=%s", size(G_sl1), G_sl1[1], dim(G_sl1));

// Full 12-var slimgb over F_32003!
printf("=== Full 12-var slimgb(I12p) over F_32003 ===");
ideal G12p = slimgb(I12p);
printf("Full 12-var F_32003: size=%s, G[1]=%s, dim=%s, vdim=%s", size(G12p), G12p[1], dim(G12p), vdim(G12p));

if (size(G12p) == 1 && G12p[1] == 1) {
  printf("UNIT_IDEAL_MOD_32003! Launching exact Q modStd(I12, 1)...");
  setring R12;
  ideal G12q = modStd(I12, 1);
  printf("Q modStd(I12, 1): size=%s, G[1]=%s", size(G12q), G12q[1]);
  if (size(G12q) == 1 && G12q[1] == 1) {
    printf("CERTIFIED_MODSTD_Q: DEGREE_135_IV_GCD_FOUR_PROVED_EMPTY_OVER_Q");
  }
}
quit;
